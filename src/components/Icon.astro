---
interface Props {
  name?: 'arrow' | 'down' | 'external' | 'github' | 'mail' | 'plus';
  size?: number;
}
const { name = 'arrow', size = 20 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'arrow' && (
    <>
      <path d="M4 12h15M13 5l7 7-7 7" />
    </>
  )}
  {name === 'down' && (
    <>
      <path d="M12 4v16M5 13l7 7 7-7" />
    </>
  )}
  {name === 'external' && (
    <>
      <path d="M6 18 18 6M6 6h12v12" />
    </>
  )}
  {name === 'github' && (
    <path
      d="M9 19c-4 1-4-2-5-2m10 4v-3.4c0-1 .1-1.5-.5-2 3.4-.4 6.8-1.6 6.8-7.4a5.7 5.7 0 0 0-1.5-4 5.2 5.2 0 0 0-.1-3.9s-1.3-.4-4.2 1.5a14.5 14.5 0 0 0-7.6 0C4 .1 2.7.5 2.7.5a5.2 5.2 0 0 0-.1 3.9 5.7 5.7 0 0 0-1.5 4c0 5.8 3.4 7 6.8 7.4-.5.4-.6 1-.5 2V21"
      transform="translate(1 1) scale(.95)"
    />
  )}
  {name === 'mail' && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="2" />
      <path d="m3 7 9 6 9-6" />
    </>
  )}
  {name === 'plus' && <path d="M12 5v14M5 12h14" />}
</svg>
