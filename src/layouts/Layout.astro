---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/inter';
import '../styles/global.css';
import { Image } from 'astro:assets';
import Icon from '../components/Icon.astro';
import { profile } from '../data/profile';
import tinkererPortrait from '../assets/tinkerer-portrait.webp';
import tinkererWave from '../assets/tinkerer-wave.webp';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = `${profile.name} | ${profile.roles.join(' & ')}`,
  description = profile.description,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#09090b" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=tinkerer" />
    <link rel="icon" type="image/png" sizes="32x32" href="/tinkerer-icon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/tinkerer-icon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="Devinda Kulatunge, home">
          <Image
            class="brand-character"
            src={tinkererPortrait}
            alt=""
            width={64}
            height={64}
            widths={[48, 64, 96, 128]}
            sizes="(max-width: 540px) 48px, 64px"
            format="webp"
            quality={90}
            loading="eager"
            decoding="async"
          />
          <span class="brand-copy">
            <span class="brand-name">{profile.name}</span>
            <span class="brand-focus brand-roles">
              {profile.roles.map((role) => (
                <span>{role}</span>
              ))}
            </span>
            <span class="brand-focus">
              {profile.focus.map((focus) => (
                <span>{focus}</span>
              ))}
            </span>
          </span>
        </a>
        <nav aria-label="Main navigation">
          <a href="/#work">
            Work<span class="nav-dot">.</span>
          </a>
          <a href="/#about">
            About<span class="nav-dot">.</span>
          </a>
          <a href="/#contact">
            Contact<span class="nav-dot">.</span>
          </a>
        </nav>
        <a
          class="header-github"
          href={profile.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub profile, opens in a new tab"
        >
          <Icon name="github" size={20} />
          <span>GitHub</span>
          <Icon name="external" size={15} />
        </a>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer container">
      <a class="footer-name" href="/">
        <Image
          class="footer-character"
          src={tinkererWave}
          alt=""
          width={56}
          height={56}
          widths={[56, 112]}
          sizes="56px"
          format="webp"
          quality={90}
          loading="lazy"
          decoding="async"
        />
        <span class="footer-domain">
          devinda<span>.</span>io
        </span>
      </a>
      <p>© {new Date().getFullYear()}</p>
      <a href={profile.repository} target="_blank" rel="noopener noreferrer">
        Website source <Icon name="external" size={15} />
      </a>
    </footer>
  </body>
</html>
