---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/inter';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { profile } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = `${profile.name} | Computer Engineering, Power, SoC, EDA & Robotics`,
  description = profile.description,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#09090b" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="Devinda Kulatunge, home">
          <span class="brand-mark" aria-hidden="true">
            d<span>.</span>
          </span>
          <span class="brand-copy">
            <span class="brand-name">{profile.name}</span>
            <span class="brand-focus">
              {profile.focus.map((focus) => (
                <span>{focus}</span>
              ))}
            </span>
          </span>
        </a>
        <nav aria-label="Main navigation">
          <a href="/#work">
            Work<span class="nav-dot">.</span>
          </a>
          <a href="/#about">
            About<span class="nav-dot">.</span>
          </a>
          <a href="/#contact">
            Contact<span class="nav-dot">.</span>
          </a>
        </nav>
        <a
          class="header-github"
          href={profile.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub profile, opens in a new tab"
        >
          <Icon name="github" size={20} />
          <span>GitHub</span>
          <Icon name="external" size={15} />
        </a>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer container">
      <a class="footer-name" href="/">
        devinda<span>.</span>io
      </a>
      <p>© {new Date().getFullYear()}</p>
      <a href={profile.repository} target="_blank" rel="noopener noreferrer">
        Website source <Icon name="external" size={15} />
      </a>
    </footer>
  </body>
</html>
