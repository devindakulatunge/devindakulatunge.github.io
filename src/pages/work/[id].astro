---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { profile } from '../../data/profile';
export async function getStaticPaths() {
  return (await getCollection('projects')).map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}
interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { Content } = await render(project);
const { data } = project;
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const next = projects[(projects.findIndex((item) => item.id === project.id) + 1) % projects.length];
---

<Layout title={`${data.title} | Devinda Kulatunge`} description={data.description}>
  <article class="project-page container">
    <a href="/#work" class="back-link">
      <span aria-hidden="true">←</span> All projects
    </a>
    <div class="project-page-heading">
      <p class="eyebrow">
        {data.category} / {data.year}
      </p>
      <h1>
        {data.title}
        <span>.</span>
      </h1>
      <p class="project-page-description">{data.description}</p>
      <div class="project-status">
        <span class="tiny-square"></span>
        {data.status}
      </div>
    </div>
    <dl class="project-overview">
      <div>
        <dt>My contribution</dt>
        <dd>{data.role}</dd>
      </div>
      <div>
        <dt>Current stage</dt>
        <dd>{data.progress}</dd>
      </div>
    </dl>
    <figure class="project-banner">
      <img src={data.image} alt={data.imageAlt} width="900" height="620" />
      <figcaption>Architecture illustration · {data.context}</figcaption>
    </figure>
    <div class="project-body">
      <aside class="project-facts">
        <div>
          <h2>Context</h2>
          <p>{data.context}</p>
        </div>
        <div>
          <h2>Tools &amp; technologies</h2>
          <ul class="tags">
            {data.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        </div>
        {data.repository && (
          <a class="text-link" href={data.repository} target="_blank" rel="noopener noreferrer">
            View repository <Icon name="external" size={16} />
          </a>
        )}
      </aside>
      <div class="prose">
        <Content />
      </div>
    </div>
    <div class="next-project">
      <span class="eyebrow">Next project</span>
      <a href={`/work/${next.id}/`}>
        {next.data.shortTitle}
        <Icon name="arrow" size={28} />
      </a>
    </div>
    <div class="project-contact">
      <p>Interested in this work?</p>
      <a class="text-link" href={`mailto:${profile.email}`}>
        Get in touch <Icon name="mail" size={18} />
      </a>
    </div>
  </article>
</Layout>
