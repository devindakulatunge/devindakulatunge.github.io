    <p class="eyebrow">404 / Page not found</p>
    <h1>
      A wrong turn<span>.</span>
    </h1>
    <p>The page you’re looking for isn’t here. My projects are a good place to start.</p>
    <a class="button button-primary" href="/#work">
      Explore my work <Icon name="arrow" size={18} />
    </a>
  </section>
</Layout>
