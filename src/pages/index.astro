---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Icon from '../components/Icon.astro';
import { profile } from '../data/profile';
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Layout>
  <section class="hero container" aria-labelledby="intro-title">
    <div class="hero-top">
      <span class="eyebrow">
        <span class="tiny-square"></span>Engineer · Oulu, Finland
      </span>
      <a class="hero-availability" href="#contact">
        <span class="location-dot"></span>Open to engineering opportunities
      </a>
    </div>
    <div class="hero-main">
      <div class="hero-title-wrap">
        <h1 id="intro-title">
          Devinda <span>Kulatunge.</span>
        </h1>
        <p class="intro-lead">Robotics, embedded systems, and the software behind them.</p>
      </div>
      <div class="hero-actions">
        <a href={`mailto:${profile.email}`} class="button button-primary">
          Get in touch <Icon name="mail" size={18} />
        </a>
        <a href={profile.github} target="_blank" rel="noopener noreferrer" class="text-link">
          <Icon name="github" size={18} /> GitHub <Icon name="external" size={15} />
        </a>
      </div>
    </div>
  </section>

  <section class="work-section container" id="work" aria-labelledby="work-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / Projects</p>
        <h2 id="work-title">
          Selected work<span>.</span>
        </h2>
      </div>
      <p class="section-intro">
        University projects in robotics, <span>embedded sensing, and digital design.</span>
      </p>
    </div>
    <div class="project-grid">
      {projects.map((project, index) => (
        <ProjectCard project={project} index={index} />
      ))}
    </div>
    <p class="work-note">
      Project visuals are architecture illustrations. Each writeup explains my contribution and the
      current stage of the work.
    </p>
  </section>

  <section class="about-section" id="about" aria-labelledby="about-title">
    <div class="container about-grid">
      <div class="about-heading">
        <p class="eyebrow">02 / About me</p>
        <h2 id="about-title">
          Hi, I’m Devinda.
          <br />
          <span>I like figuring things out.</span>
        </h2>
        <p class="about-location">
          <span class="location-dot"></span>Based in Oulu, Finland
        </p>
        <a href={profile.github} target="_blank" rel="noopener noreferrer" class="text-link">
          Find me on GitHub <Icon name="external" size={18} />
        </a>
      </div>
      <div class="about-content">
        <p class="about-lead">
          I’m an electrical engineer interested in how hardware and software work together to solve
          practical problems.
        </p>
        <p>
          After studying at the University of Nottingham, I worked at Synopsys Lanka on power
          estimation and signoff validation for PrimePower. I’m now pursuing an MSc in Computer
          Science and Engineering at the University of Oulu, specializing in Computer Engineering.
        </p>
        <p>
          My current projects take that interest into robot simulation and embedded sensing. I’m
          drawn to the connections between components: how a physical model affects a sensor, how
          signal quality affects a decision, and what a test actually proves.
        </p>
        <div class="experience-list">
          <div class="experience-row">
            <span class="experience-date">2026 to present</span>
            <div>
              <h3>University of Oulu</h3>
              <p>
                MSc (Tech), Computer Science and Engineering
                <br />
                <span>Specialization: Computer Engineering</span>
              </p>
            </div>
          </div>
          <div class="experience-row">
            <span class="experience-date">2022 to 2026</span>
            <div>
              <h3>Synopsys Lanka</h3>
              <p>
                Power Estimation &amp; Signoff Validation Engineer
                <br />
                <span>PrimePower</span>
              </p>
            </div>
          </div>
          <div class="experience-row">
            <span class="experience-date">BEng</span>
            <div>
              <h3>University of Nottingham</h3>
              <p>Electrical and Electronic Engineering</p>
            </div>
          </div>
        </div>
        <div class="toolbox">
          <span class="eyebrow">Working with</span>
          <p>
            C / C++ <span>·</span> Python <span>·</span> Linux <span>·</span> MATLAB <span>·</span>{' '}
            Git <span>·</span> Embedded systems
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="contact-section container" id="contact" aria-labelledby="contact-title">
    <div class="contact-top">
      <p class="eyebrow">03 / Contact</p>
      <span class="contact-availability">
        <span class="location-dot"></span>Open to engineering opportunities
      </span>
    </div>
    <div class="contact-main">
      <h2 id="contact-title">
        Let’s build
        <br />
        <span>something useful.</span>
      </h2>
      <a class="contact-arrow" href={`mailto:${profile.email}`} aria-label="Email Devinda">
        <Icon name="external" size={54} />
      </a>
    </div>
    <div class="contact-bottom">
      <p>
        Have a role, a project, or an interesting problem?
        <br />
        I’d like to hear about it.
      </p>
      <a class="email-link" href={`mailto:${profile.email}`}>
        {profile.email}
        <Icon name="external" size={18} />
      </a>
    </div>
  </section>
</Layout>
